# Six Degrees — environment variables
# Copy to .env and fill in real values. .env is gitignored; never commit it.

# CognoDB / Neo4j connection, e.g. bolt+s://<instance-id>.databases.cognodb.cloud
NEO4J_URI=bolt://localhost:7687
# CognoDB always uses the user "cognodb"; local Neo4j uses "neo4j".
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# HTTP port for the web app (Render sets PORT; defaults to 3000).
# PORT=3000
